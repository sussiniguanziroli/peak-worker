# Copiá este archivo a .env y completá los valores en la VM.
# El .env real está en .gitignore y NO se commitea.

# Misma service account que el ingestor (no se copia la key, se apunta a ella).
# Necesita roles/bigquery.jobUser a nivel proyecto para poder consultar.
GOOGLE_APPLICATION_CREDENTIALS=/home/fortunato_ctech/iot-ingestor-server/serviceAccountKey.json

# true (por defecto) = solo loguea lo que escribiría. false = escribe en Firestore.
DRY_RUN=true

INTERVAL_MIN=60
LOOKBACK_MIN=135
MAX_GAP_S=120
